LDAPLogin {
    org.apache.activemq.artemis.spi.core.security.jaas.LDAPLoginModule required
        debug=true
        initialContextFactory=com.sun.jndi.ldap.LdapCtxFactory
        connectionURL="ldap://ldap.local"
        connectionUsername="cn=admin,dc=redhat,dc=local"
        connectionPassword="admin"
        connectionProtocol=""
        authentication=simple
        userBase="ou=people,dc=redhat,dc=local"
        userSearchMatching="(&(objectClass=person)(cn={0}))"
        userSearchSubtree=false
        roleBase="ou=groups,dc=redhat,dc=local"
        roleName=cn
        roleSearchMatching="(uniqueMember={0})"
        ;
};

CertLogin {
   org.apache.activemq.artemis.spi.core.security.jaas.TextFileCertificateLoginModule required
       debug=true
       org.apache.activemq.jaas.textfiledn.user="cert-users.properties"
       org.apache.activemq.jaas.textfiledn.role="cert-roles.properties";
};
