# Component Versions
# Update these to test different version combinations

# Kafka version (using Apache Kafka image)
KAFKA_VERSION=latest

# Debezium version
DEBEZIUM_VERSION=3.0

# Oracle Database version (XE = Express Edition)
# Use -faststart for faster startup (pre-configured database)
ORACLE_VERSION=21.3.0-faststart

# Oracle JDBC Driver version
ORACLE_JDBC_VERSION=21.6.0.0
